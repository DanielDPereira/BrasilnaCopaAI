# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Múltiplas chaves da API do Gemini separadas por vírgula (opcional para rotação/tolerância a falhas)
GEMINI_API_KEYS=chave_1,chave_2,chave_3

# Usar embeddings locais baseados em ONNX (MiniLM) para evitar limites de cota e rodar offline (true/false)
USE_LOCAL_EMBEDDINGS=true

# Configurações do Banco Vetorial ChromaDB
CHROMA_DB_PATH=data/db

# Configurações do Backend (FastAPI)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# URL do Backend consumido pelo Frontend (Streamlit)
BACKEND_URL=http://127.0.0.1:8000
