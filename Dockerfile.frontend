FROM python:3.12-slim

# Evita que o Python grave arquivos .pyc no disco e faça buffering de stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace

# Instala dependências do sistema necessárias para curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copia e instala as dependências do Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código fonte da interface Streamlit
COPY streamlit/ /workspace/streamlit/

# Expõe a porta padrão do Streamlit
EXPOSE 8501

# Executa o painel do Streamlit exposto para conexões externas
CMD ["streamlit", "run", "streamlit/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
